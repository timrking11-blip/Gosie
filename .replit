modules = ["nodejs-24", "python-base-3.13"]

[workflows]
runButton = "Project"

[[ports]]
localPort = 8081
externalPort = 8081
exposeLocalhost = true

[[ports]]
localPort = 21101
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 23967
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "cloudrun"
